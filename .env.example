LLM_PROVIDER=groq
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=45

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_FORMAT=hidden
GROQ_REASONING_EFFORT=low
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Automatic OpenRouter fallback when Groq quota/size limits are hit
LLM_FALLBACK_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/marciano147/Airport-Investment-Intelligence-Agent
OPENROUTER_APP_NAME=Airport Investment Intelligence Agent

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airport-agent
